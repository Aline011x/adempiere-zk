<?xml version="1.0" encoding="UTF-8"?>

<zk>
	<!-- Adempiere thread session context handler -->
	<system-config>
		<disable-event-thread>false</disable-event-thread>
		<client-timeout>1800000</client-timeout>
		<id-generator-class>org.adempiere.webui.AdempiereIdGenerator</id-generator-class>
		<disable-theme-uri>false</disable-theme-uri>
		<file-upload-progress-listener-class>
			org.zkoss.zkmax.ui.http.MaxFileUploadProgressListener
		</file-upload-progress-listener-class>
	</system-config>

	<client-config>
		<cdn>auto</cdn>
		<data-handler-class>org.zkoss.zk.au.http.AuDynaMediator</data-handler-class>
	</client-config>

	<device-config>
		<device-type>ajax</device-type>
		<server-push-class>org.zkoss.zkmax.au.websocket.WebSocketServerPush</server-push-class>
		<embed-device-js>true</embed-device-js>
	</device-config>

	<session-config>
		<device-type>ajax</device-type>
		<automatic-timeout>true</automatic-timeout>
		<timeout-uri>/timeout.zul</timeout-uri>
		<timer-enabled>true</timer-enabled>
	</session-config>

	<listener>
		<description>ADempiere WebUI Context management</description>
		<listener-class>org.adempiere.webui.session.SessionContextListener</listener-class>
	</listener>

	<listener>
		<listener-class>org.zkoss.zk.ui.util.Statistic</listener-class>
		<description>Registra estadísticas de rendimiento y eventos</description>
	</listener>

	<library-property>
		<name>org.zkoss.zul.theme.fontSizeM
		</name>
		<value>11px</value>
	</library-property>
	<library-property>
		<name>org.zkoss.zul.theme.fontSizeS
		</name>
		<value>10px</value>
	</library-property>
	<library-property>
		<name>org.zkoss.zul.theme.fontSizeXS
		</name>
		<value>9px</value>
	</library-property>
	<library-property>
		<name>org.zkoss.zul.theme.fontSizeMS
		</name>
		<value>11px</value>
	</library-property>
	<library-property>
		<name>org.zkoss.theme.preferred</name>
		<value>default</value>
	</library-property>
	<library-property>
		<name>org.zkoss.web.preferred.contextPath</name>
		<value>/adempiere</value>
	</library-property>
	<library-property>
		<name>org.zkoss.zul.cache.client</name>
		<value>true</value>
	</library-property>

	<system-config>
		<log-level>trace</log-level>
		<client-config>
			<debug-js>true</debug-js>
		</client-config>
	</system-config>

</zk>
