<?xml version="1.0" encoding="utf-8"?>
<!--
Purpose:
    Defines methods and actions for DSP
Description:
    Updated for ZK 6.5.7
Copyright:
    (C) 2005-2013 Potix Corporation. All Rights Reserved.
-->

<taglib version="2.1"
		xmlns="http://java.sun.com/xml/ns/javaee"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                        http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd">
	<description>Methods and actions for ZK in DSP/ZUML</description>
	<tlib-version>2.1</tlib-version>
	<short-name>zulcoredsp</short-name>
	<uri>http://www.zkoss.org/dsp/zk/core</uri>

	<!-- Functions -->

	<function>
<!--		<description>Redraw the specified component.</description>-->
		<name>redraw</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>void redraw(org.zkoss.zk.ui.Component, java.io.Writer)</function-signature>
	</function>

	<function>
		<name>outResponseJavaScripts</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outResponseJavaScripts(java.util.Collection)</function-signature>
<!--		<description>Returns JavaScript to handle the specified responses.</description>-->
	</function>

	<function>
<!--		<description>Returns HTML tags to include all JavaScripts used by all languages.</description>-->
		<name>outLangJavaScripts</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outLangJavaScripts(java.lang.String)</function-signature>
	</function>

	<function>
<!--		<description>Returns HTML tags to include all style sheets used by all languages.</description>-->
		<name>outLangStyleSheets</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outLangStyleSheets()</function-signature>
	</function>

	<function>
<!--		<description>Generates the unavailable message in HTML tags, if any.</description>-->
		<name>outHtmlUnavailable</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outHtmlUnavailable(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Returns the content for the header element of the specified page.</description>-->
		<name>outHeaders</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outHeaders(org.zkoss.zk.ui.Page, boolean)</function-signature>
	</function>

	<function>
<!--		<description>Returns attributes of the root element of the specified page.</description>-->
		<name>outRootAttributes</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outRootAttributes(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Returns the content type.</description>-->
		<name>outContentType</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outContentType(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Returns the document type.</description>-->
		<name>outDocType</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outDocType(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Returns the first line to output.</description>-->
		<name>outFirstLine</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outFirstLine(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Converts the URI to absolute if necessary.</description>-->
		<name>toAbsoluteURI</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String toAbsoluteURI(java.lang.String, boolean)</function-signature>
	</function>

	<function>
<!--		<description>Returns the attributes to render a page.</description>-->
		<name>outPageAttrs</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outPageAttrs(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Returns the ZK specific HTML tags.</description>-->
		<name>outZkHtmlTags</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outZkHtmlTags()</function-signature>
	</function>

	<function>
<!--		<description>Returns the ZK specific head HTML tags with page headers.</description>-->
		<name>outZkHeadHtmlTags</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outZkHeadHtmlTags(org.zkoss.zk.ui.Page)</function-signature>
	</function>

	<function>
<!--		<description>Removes CSS classes and styles from the input.</description>-->
		<name>noCSSAttrs</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String noCSSAttrs(java.lang.String)</function-signature>
	</function>

	<function>
<!--		<description>Returns only CSS classes and styles from the input.</description>-->
		<name>outCSSAttrs</name>
		<function-class>org.zkoss.zk.fn.ZkFns</function-class>
		<function-signature>java.lang.String outCSSAttrs(java.lang.String)</function-signature>
	</function>

	<function>
<!--		<description>Returns date-relevant labels in JavaScript.</description>-->
		<name>outLocaleJavaScript</name>
		<function-class>org.zkoss.zk.fn.DspFns</function-class>
		<function-signature>java.lang.String outLocaleJavaScript()</function-signature>
	</function>

	<function>
<!--		<description>Returns HTML tags to include style sheets for the specified device.</description>-->
		<name>outDeviceStyleSheets</name>
		<function-class>org.zkoss.zk.fn.DspFns</function-class>
		<function-signature>java.lang.String outDeviceStyleSheets(java.lang.String)</function-signature>
	</function>

	<function>
<!--		<description>Sets Cache-Control and Expires headers for the current request.</description>-->
		<name>setCacheControl</name>
		<function-class>org.zkoss.zk.fn.DspFns</function-class>
		<function-signature>void setCacheControl(java.lang.String, int)</function-signature>
	</function>

	<function>
<!--		<description>Sets Cache-Control and Expires headers for CSS class Web resources.</description>-->
		<name>setCSSCacheControl</name>
		<function-class>org.zkoss.zk.fn.DspFns</function-class>
		<function-signature>void setCSSCacheControl()</function-signature>
	</function>

	<function>
<!--		<description>Sets Cache-Control and Expires headers for class Web resources.</description>-->
		<name>setCWRCacheControl</name>
		<function-class>org.zkoss.zk.fn.DspFns</function-class>
		<function-signature>void setCWRCacheControl()</function-signature>
	</function>

</taglib>
