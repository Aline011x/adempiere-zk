<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Modificado para compatibilidad con ZK 6.5.7
   - Ajustes para integración con componentes ZK
-->

<taglib version="2.1"
		xmlns="http://java.sun.com/xml/ns/javaee"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                        http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd">
	<description>HTML tags for ZK DSP in version 6.5.4</description>
	<tlib-version>2.1</tlib-version>
	<short-name>htmldsp</short-name>
	<uri>http://www.zkoss.org/zk/html</uri>

	<!-- ========== TAGS ACTUALIZADOS ========== -->
	<tag>
		<description>
			Display a box with caption and border (Equivalente a Div/Caption en ZK 6+)
		</description>
		<name>box</name>
<!--		<tag-class>org.zkoss.zk.ui.dsp.html.Box</tag-class>-->
<!--		<body-content>empty</body-content>-->
	</tag>

	<tag>
		<description>
			Generates HTML img tag (Compatibilidad mejorada con ZK Components)
		</description>
		<name>img</name>
		<!-- Clase actualizada -->
<!--		<tag-class>org.zkoss.zk.ui.dsp.html.Img</tag-class>-->
<!--		<body-content>empty</body-content>-->
	</tag>
</taglib>